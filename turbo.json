{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build", "^test"]
    },
    "test:coverage": {
      "dependsOn": ["^build", "^test:coverage"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:security": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "ai:test": {
      "dependsOn": ["^build"]
    },
    "ai:eval": {
      "dependsOn": ["^build"]
    },
    "test:a11y": {
      "dependsOn": ["^build"]
    },
    "test:observability": {
      "dependsOn": ["^build"]
    }
  }
}
