{
  "name": "tripforge",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "db:check": "pnpm --filter @tripforge/api db:check",
    "db:generate": "pnpm --filter @tripforge/api db:generate",
    "db:migrate": "pnpm --filter @tripforge/api db:migrate",
    "db:studio": "pnpm --filter @tripforge/api db:studio",
    "lint": "turbo run lint",
    "perf:bundle": "pnpm --filter @tripforge/web build && pnpm perf:bundle:check",
    "perf:bundle:check": "node scripts/performance/check-bundle-budget.mjs",
    "perf:bundle:report": "node scripts/performance/report-bundle.mjs",
    "perf:db": "pnpm --filter @tripforge/api perf:db",
    "perf:test": "node --test scripts/performance/*.test.mjs",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:a11y": "pnpm --filter @tripforge/web test:a11y",
    "test:integration": "pnpm --filter @tripforge/api test:integration",
    "test:coverage": "turbo run test:coverage",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:full": "pnpm check && pnpm test:integration"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "turbo": "2.10.12",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@12.3.4"
}
