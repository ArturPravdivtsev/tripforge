{
  "name": "@tripforge/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "ai:eval": "vitest run src/ai/evals",
    "ai:eval:live": "node scripts/ai-live-eval.mjs",
    "ai:test": "vitest run src/ai",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "worker:health": "node dist/worker-health.js",
    "lint": "eslint .",
    "perf:db": "node scripts/performance/db-performance.mjs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts --no-file-parallelism",
    "test:observability": "vitest run src/observability test/observability.e2e-spec.ts",
    "test:security": "vitest run src/security src/auth/password src/auth/session src/realtime/realtime.spec.ts src/storage/s3-storage.service.spec.ts test/browser-policy.e2e-spec.ts test/application.e2e-spec.ts && vitest run --config vitest.integration.config.mts --no-file-parallelism test/security.integration-spec.ts test/auth.integration-spec.ts test/realtime.integration-spec.ts",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1135.0",
    "@aws-sdk/s3-request-presigner": "3.1135.0",
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/platform-socket.io": "11.2.3",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "11.2.3",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/instrumentation-aws-sdk": "0.77.0",
    "@opentelemetry/instrumentation-express": "0.70.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/instrumentation-pg": "0.74.0",
    "@opentelemetry/instrumentation-runtime-node": "0.35.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@socket.io/redis-streams-adapter": "0.3.1",
    "@tripforge/contracts": "workspace:*",
    "argon2": "0.45.1",
    "bullmq": "6.3.8",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.2",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "joi": "18.2.8",
    "openai": "7.27.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.3",
    "@testcontainers/localstack": "12.1.0",
    "@testcontainers/postgresql": "12.1.0",
    "@testcontainers/redis": "12.1.0",
    "@tripforge/eslint-config": "workspace:*",
    "@tripforge/typescript-config": "workspace:*",
    "@types/cookie-parser": "1.4.10",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "socket.io-client": "4.8.3",
    "supertest": "7.2.2",
    "typescript": "5.9.3",
    "vitest": "catalog:"
  }
}
