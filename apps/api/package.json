{
  "name": "@tripforge/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "worker:health": "node dist/worker-health.js",
    "lint": "eslint .",
    "perf:db": "node scripts/performance/db-performance.mjs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1135.0",
    "@aws-sdk/s3-request-presigner": "3.1135.0",
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/platform-socket.io": "11.2.3",
    "@nestjs/websockets": "11.2.3",
    "@socket.io/redis-streams-adapter": "0.3.1",
    "@tripforge/contracts": "workspace:*",
    "argon2": "0.45.1",
    "bullmq": "6.3.8",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.2",
    "ioredis": "6.0.0",
    "joi": "18.2.8",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.3",
    "@testcontainers/localstack": "12.1.0",
    "@testcontainers/postgresql": "12.1.0",
    "@testcontainers/redis": "12.1.0",
    "@tripforge/eslint-config": "workspace:*",
    "@tripforge/typescript-config": "workspace:*",
    "@types/cookie-parser": "1.4.10",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "socket.io-client": "4.8.3",
    "supertest": "7.2.2",
    "typescript": "5.9.3",
    "vitest": "catalog:"
  }
}
