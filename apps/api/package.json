  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.3",
    "@tripforge/eslint-config": "workspace:*",
    "@tripforge/typescript-config": "workspace:*",
    "@types/node": "24.13.3",
