NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://tripforge:tripforge@127.0.0.1:5433/tripforge
# Production AWS may use DATABASE_HOST, DATABASE_PORT, DATABASE_NAME,
# DATABASE_USER, DATABASE_PASSWORD, and DATABASE_SSL=true instead.
REDIS_URL=redis://127.0.0.1:6379
WEB_ORIGIN=http://127.0.0.1:3000
SECURITY_RATE_LIMITING_ENABLED=true
LOG_LEVEL=debug
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORT_TIMEOUT_MS=3000
OTEL_METRIC_EXPORT_INTERVAL_MS=15000
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1
TRIPFORGE_VERSION=local
OPENROUTESERVICE_API_KEY=
AI_ASSISTANT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=medium
OPENAI_TIMEOUT_MS=45000
OPENAI_MAX_OUTPUT_TOKENS=1500
S3_BUCKET=tripforge-documents
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:4566
S3_PUBLIC_ENDPOINT=http://localhost:4566
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
